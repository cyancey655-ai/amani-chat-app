# Copy to .env for local dev. NEVER commit real keys.
SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:5000
SECURE_COOKIES=0
# DATABASE_URL=sqlite:////tmp/amani.db   # or postgres://...

# AI chat (OpenAI or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Stripe (all from the Stripe Dashboard — live keys for real money)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=      # price_...  ($24.99/mo recurring)
STRIPE_PRICE_METERED=      # price_...  ($1.00 per unit, tied to the billing meter)
STRIPE_METER_EVENT_NAME=amani_chat_minute
